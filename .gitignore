# --- LaTeX project folders: track only source files, drop build artifacts ---
# (*.aux, *.log, *.fls, *.fdb_latexmk, *.synctex.gz, *.bcf, *.run.xml, *.blg,
#  *.out, *.nav, *.snm, *.toc, *.vrb, *.idx, *.ind, *.ilg, *.dvi, *.bak, etc.)
# Keeps: tex, cls, bib, bbl, pdf, images, and the .py/.md/.zip/.latexmkrc
# source/asset files used to build figures and slides.
texs/**
latticems/**
presentations/**
epirefs/**
others/**

!texs/**/
!texs/**/*.tex
!texs/**/*.cls
!texs/**/*.bib
!texs/**/*.bbl
!texs/**/*.pdf
!texs/**/*.png
!texs/**/*.jpg
